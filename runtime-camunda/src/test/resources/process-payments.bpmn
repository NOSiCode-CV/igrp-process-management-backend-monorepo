  <bpmn:process id="process-payments" name="Process payments" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Payment request received">
      <bpmn:outgoing>Flow_0rrvmnp</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0rrvmnp" sourceRef="StartEvent_1" targetRef="Activity_0iyqkd6" />
    <bpmn:scriptTask id="Activity_0iyqkd6" name="Prepare transaction">
      <bpmn:extensionElements>
        <zeebe:script expression="=total * 1.1" resultVariable="totalWithTax" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rrvmnp</bpmn:incoming>
      <bpmn:outgoing>Flow_1uqi2fy</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1uqi2fy" sourceRef="Activity_0iyqkd6" targetRef="Activity_1dh9g9w" />
    <bpmn:serviceTask id="Activity_1dh9g9w" name="Charge credit card">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-credit-card" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1uqi2fy</bpmn:incoming>
      <bpmn:outgoing>Flow_13tr5o3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_18xi74u" name="Payment executed">
      <bpmn:incoming>Flow_13tr5o3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13tr5o3" sourceRef="Activity_1dh9g9w" targetRef="Event_18xi74u" />
  </bpmn:process>
